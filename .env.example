# Telegram bot tokeni (https://t.me/BotFather)
BOT_TOKEN=

# === Provayder tanlovi ===
# Chat (LLM) uchun: groq | openai | gemini
LLM_PROVIDER=groq
# Ovozni matnga o'girish (ASR) uchun: groq | openai | gemini | qwen
ASR_PROVIDER=gemini

# === Har bir provayder uchun API kalitlar ===
# Faqat tanlangan provayderlar uchun to'ldirish kifoya
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=

# === Har bir provayder uchun chat (LLM) modeli ===
# Bo'sh qoldirilsa standart model ishlatiladi
GROQ_LLM_MODEL=llama-3.1-8b-instant
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_LLM_MODEL=gemini-2.5-flash

# === Har bir provayder uchun ASR modeli ===
# Bo'sh qoldirilsa standart model ishlatiladi
GROQ_ASR_MODEL=whisper-large-v3
OPENAI_ASR_MODEL=whisper-1
GEMINI_ASR_MODEL=gemini-2.5-flash
QWEN_ASR_MODEL=qwen-audio-asr

# === Ixtiyoriy: maxsus base URL'lar (masalan, lokal/OpenAI-mos serverlar) ===
# GROQ_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# QWEN_BASE_URL=

# Transkripsiya tili kodi
ASR_LANGUAGE=uz
