# Telegram bot tokeni (https://t.me/BotFather)
BOT_TOKEN=

# Chat (LLM) sozlamalari — provider: groq | openai
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=

# ASR (ovozni matnga o'girish) sozlamalari — provider: groq | openai | gemini | qwen
ASR_PROVIDER=groq
# Bo'sh qoldirilsa LLM_API_KEY ishlatiladi
# ASR_API_KEY=
ASR_MODEL=whisper-large-v3
# ASR_BASE_URL=
ASR_LANGUAGE=uz

# --- Misollar ---
# Gemini:  ASR_PROVIDER=gemini  ASR_MODEL=gemini-1.5-flash  ASR_API_KEY=<google_api_key>
# Qwen:    ASR_PROVIDER=qwen    ASR_MODEL=qwen-audio-asr    ASR_API_KEY=<dashscope_api_key>
# OpenAI:  ASR_PROVIDER=openai  ASR_MODEL=whisper-1         ASR_API_KEY=<openai_api_key>
